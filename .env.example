# Copy to .env and edit. All settings are optional; the values below are the defaults.

# Folder for batch results (results.csv, powerbi_summary.csv).
SUPPLYTRACE_RESULTS_DIR=results
# Folder where the startup bootstrap writes the synthetic invoices.
SUPPLYTRACE_DATA_DIR=data/raw_xml
# Folder for audit_log.jsonl (empty means same as the results folder).
SUPPLYTRACE_AUDIT_DIR=
# Size in bytes at which the audit log is rotated.
SUPPLYTRACE_AUDIT_MAX_BYTES=1000000
# Largest accepted upload in bytes.
SUPPLYTRACE_MAX_UPLOAD_BYTES=1000000
# Set to 0 to skip generating the demo dataset on startup.
SUPPLYTRACE_BOOTSTRAP=1
# SQLite file for the review queue, invoice records and vendor notes.
SUPPLYTRACE_DB_PATH=data/supplytrace.db
# Optional database URL (for example PostgreSQL); leave empty to use SQLite.
DATABASE_URL=
